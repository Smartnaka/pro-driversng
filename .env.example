# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Server-side Paystack Secret Key (sk_test_...) for payment initialization, verification, and webhook HMAC verification.
PAYSTACK_SECRET_KEY=

# PAYSTACK_PUBLIC_KEY: Optional Paystack Public Key (pk_test_...)
PAYSTACK_PUBLIC_KEY=

# VITE_GOOGLE_MAPS_API_KEY: Optional public browser key for interactive Google Maps route/location preview.
VITE_GOOGLE_MAPS_API_KEY=
